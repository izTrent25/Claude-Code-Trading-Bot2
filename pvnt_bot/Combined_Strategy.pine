//@version=6
// COMBINED STRATEGY (work in progress). Indicators are added one by one; no backtest until the user says so.
//   Part 1: FVG / iFVG rebuild           (pvnt_bot/FVG_iFVG_Indicator.pine), plus buy/sell volume bars per gap
//   Part 2: Order blocks: the leg before the liquidity sweep, one per trend, strong displacement
//   Part 3: Swing points and liquidity    (own build of the idea in "Swing Points and Liquidity" by Leviathan)
//   Part 4: Market structure: BOS / CHoCH, strong/weak high and low, premium/discount, previous D/W/M levels
//           (own build of the structure ideas in LuxAlgo "Smart Money Concepts")
//   Part 5: (next indicator goes here)
// Setup signal (proposed, switchable):
//   LONG  = trend is up (last shift bullish), a live bullish order block exists, and price comes back into a
//           bullish FVG that overlaps that block. One signal per block. Stop idea: below the block.
//   SHORT = mirror. Target: not decided yet.
// It only draws and marks signals. It is an indicator for now so nothing can be backtested by accident.
indicator("Combined: FVG + OB + Liquidity + Structure", "Combined", overlay = true, max_boxes_count = 500, max_lines_count = 500,
     max_labels_count = 500, max_bars_back = 1000)

// ═════════════════════════ PART 1: FAIR VALUE GAPS ═════════════════════════
// ───────────────────────── Inputs ─────────────────────────
gG = "FVG: general"
fillMode   = input.string("Close", "Filled means", options = ["Wick", "Close"], group = gG,
     tooltip = "Wick: a wick reaching the far edge of the gap fills it. Close: a candle has to close through the far edge.")
onFilled   = input.string("Delete", "When filled", options = ["Delete", "Dim"], group = gG,
     tooltip = "Delete removes a filled gap. Dim keeps it on the chart, faded and frozen.")
showInv    = input.bool(false, "Show inverted gaps (iFVG)", group = gG,
     tooltip = "A candle body closing through the far edge flips the gap into the opposite kind of level (dashed border). It is removed when a body closes back through it.")
extendMode = input.string("Fixed", "Box length", options = ["Fixed", "Until removed"], group = gG)
extendBars = input.int(20, "Fixed length (bars from candle 1)", minval = 1, maxval = 500, group = gG)
showCE     = input.bool(true, "Midpoint line (CE)", group = gG)
showLabels = input.bool(true, "Labels", group = gG)
transp     = input.int(80, "Box transparency", minval = 0, maxval = 100, group = gG)
dimTransp  = input.int(94, "Dimmed transparency", minval = 0, maxval = 100, group = gG)
maxBack    = input.int(300, "Max bars back", minval = 20, maxval = 5000, group = gG,
     tooltip = "Only look for new gaps within this many bars of the last bar. Higher loads slower.")
maxPerDir  = input.int(30, "Max live gaps per direction", minval = 1, maxval = 150, group = gG)

gF = "FVG: filters (0 = off)"
minGapAtr = input.float(0.0, "Minimum gap size, x ATR(14)", minval = 0, step = 0.1, group = gF,
     tooltip = "Skip gaps smaller than this many ATRs. 0.3 to 0.5 removes most micro-gaps in chop.")
dispAtr   = input.float(0.0, "Middle candle body, x ATR(14)", minval = 0, step = 0.1, group = gF,
     tooltip = "Require the middle (displacement) candle's body to be at least this many ATRs.")
dispPct   = input.float(0.0, "Middle candle body, % of its range", minval = 0, maxval = 100, step = 5, group = gF,
     tooltip = "Require the middle candle's body to be at least this share of its high-to-low range. 60 to 70 enforces a real push.")
useSess   = input.bool(false, "Session filter", group = gF)
sessStr   = input.session("0930-1100", "Session (New York time)", group = gF)

gT = "FVG: higher timeframes (only drawn when above the chart's own timeframe)"
tf1 = input.timeframe("15", "Higher timeframe 1", group = gT)
s1  = input.bool(false, "Show higher timeframe 1", group = gT)
tf2 = input.timeframe("60", "Higher timeframe 2", group = gT)
s2  = input.bool(false, "Show higher timeframe 2", group = gT)
tf3 = input.timeframe("240", "Higher timeframe 3", group = gT)
s3  = input.bool(false, "Show higher timeframe 3", group = gT)
tf4 = input.timeframe("D", "Higher timeframe 4", group = gT)
s4  = input.bool(false, "Show higher timeframe 4", group = gT)

gV = "FVG: buy/sell volume"
showVol   = input.bool(true, "Buy/sell volume bars in each gap", group = gV,
     tooltip = "Splits the middle (displacement) candle's volume into buying and selling, using a lower timeframe about 10x faster than the chart. Up-closing lower candles count as buying, down-closing as selling. Two bars show the split; they always add to 100%.")
showTot   = input.bool(true, "Total volume text in each gap", group = gV)
showDash  = input.bool(true, "Volume dashboard (top right)", group = gV)
volUp     = input.color(color.rgb(26, 194, 216), "Buying bar", group = gV)
volDn     = input.color(color.rgb(216, 118, 26), "Selling bar", group = gV)
relSize   = input.float(0, "Minimum gap size, % of biggest gap in last 1000 bars", minval = 0, maxval = 100, step = 5, group = gF,
     tooltip = "0 = off. 10 is a size filter some FVG indicators use: drops gaps smaller than a tenth of the biggest recent one.")

gC = "FVG colors"
bullCol  = input.color(#26a69a, "Bullish gap", group = gC)
bearCol  = input.color(#ef5350, "Bearish gap", group = gC)
iBullCol = input.color(#2962ff, "Inverted, now support", group = gC)
iBearCol = input.color(#ff9800, "Inverted, now resistance", group = gC)
ceCol    = input.color(#9598a1, "Midpoint line", group = gC)

// ───────────────────────── Types and helpers ─────────────────────────
type Zone
    box    bx
    line   ce
    label  lb
    float  top
    float  bot
    int    dir        // +1 = support (bullish), -1 = resistance (bearish)
    string state      // FRESH, PARTIAL, CE, FILLED
    bool   inverted
    string tfName
    float  buyPct     // % of the middle candle's volume that was buying (na for higher-timeframe gaps)
    float  totVol
    box    buyBar
    box    sellBar

var zones = array.new<Zone>()
barMs = timeframe.in_seconds(timeframe.period) * 1000

tfLabel(string tf) =>
    sec = timeframe.in_seconds(tf)
    sec >= 604800 ? "W" : sec >= 86400 ? "D" : sec >= 3600 ? str.tostring(sec / 3600) + "h" : str.tostring(sec / 60) + "m"

zoneColor(int dir, bool inverted) =>
    inverted ? (dir == 1 ? iBullCol : iBearCol) : (dir == 1 ? bullCol : bearCol)

zoneText(string tfn, bool inverted) =>
    (tfn == "" ? "" : tfn + " ") + (inverted ? "iFVG" : "FVG")

// Filters shared by chart and higher-timeframe gaps.
passes(float top, float bot, float body2, float range2, float atrv) =>
    gapOk  = minGapAtr == 0 or (top - bot) >= minGapAtr * atrv
    dispOk = (dispAtr == 0 or body2 >= dispAtr * atrv) and (dispPct == 0 or body2 >= dispPct / 100 * range2)
    sessOk = not useSess or not na(time(timeframe.period, sessStr, "America/New_York"))
    gapOk and dispOk and sessOk

newZone(float top, float bot, int dir, string tfn, int leftT, float buyPct = na, float totVol = na) =>
    col    = zoneColor(dir, false)
    rightT = extendMode == "Fixed" ? leftT + extendBars * barMs : time
    mid    = (top + bot) / 2
    bx = box.new(leftT, top, rightT, bot, xloc = xloc.bar_time, border_color = color.new(col, 0), border_width = 1,
         border_style = line.style_solid, bgcolor = color.new(col, transp))
    line ce = na
    if showCE
        ce := line.new(leftT, mid, rightT, mid, xloc = xloc.bar_time, color = color.new(ceCol, 30), style = line.style_dotted)
    label lb = na
    if showLabels
        lb := label.new(rightT, mid, zoneText(tfn, false), xloc = xloc.bar_time, style = label.style_label_left,
             color = color.new(color.black, 100), textcolor = color.new(col, 0), size = size.small)
    if showTot and not na(totVol)
        box.set_text(bx, str.tostring(totVol, format.volume))
        box.set_text_halign(bx, text.align_right)
        box.set_text_size(bx, size.small)
        box.set_text_color(bx, color.new(chart.fg_color, 30))
    box buyB  = na
    box sellB = na
    if showVol and not na(buyPct)
        half = extendBars * barMs / 2   // a 100% bar reaches the middle of the box
        sellB := box.new(leftT, top, leftT + int(half * (100 - buyPct) / 100), mid, xloc = xloc.bar_time,
             bgcolor = color.new(volDn, 20), border_color = na, text = str.tostring(math.round(100 - buyPct)) + "%",
             text_size = size.tiny, text_color = chart.fg_color, text_halign = text.align_right)
        buyB := box.new(leftT, mid, leftT + int(half * buyPct / 100), bot, xloc = xloc.bar_time,
             bgcolor = color.new(volUp, 20), border_color = na, text = str.tostring(math.round(buyPct)) + "%",
             text_size = size.tiny, text_color = chart.fg_color, text_halign = text.align_right)
    array.push(zones, Zone.new(bx, ce, lb, top, bot, dir, "FRESH", false, tfn, buyPct, totVol, buyB, sellB))

kill(Zone z) =>
    box.delete(z.bx)
    line.delete(z.ce)
    label.delete(z.lb)
    box.delete(z.buyBar)
    box.delete(z.sellBar)

invert(Zone z) =>
    z.inverted := true
    z.dir      := -z.dir
    z.state    := "FRESH"
    col = zoneColor(z.dir, true)
    box.set_border_color(z.bx, color.new(col, 0))
    box.set_border_style(z.bx, line.style_dashed)
    box.set_bgcolor(z.bx, color.new(col, transp))
    if not na(z.lb)
        label.set_text(z.lb, zoneText(z.tfName, true))
        label.set_textcolor(z.lb, color.new(col, 0))

dim(Zone z) =>
    z.state := "FILLED"
    col = zoneColor(z.dir, z.inverted)
    box.set_border_color(z.bx, color.new(col, 60))
    box.set_bgcolor(z.bx, color.new(col, dimTransp))
    if not na(z.ce)
        line.set_color(z.ce, color.new(ceCol, 80))
    if not na(z.lb)
        label.set_textcolor(z.lb, color.new(col, 60))
    if not na(z.buyBar)
        box.set_bgcolor(z.buyBar, color.new(volUp, 80))
        box.set_bgcolor(z.sellBar, color.new(volDn, 80))

// Higher-timeframe gap check, non-repainting: values of the last COMPLETED higher-timeframe bar.
// Returns: isBull, isBear, bullTop, bullBot, bearTop, bearBot, time of candle 3, time of candle 1,
//          middle candle body, middle candle range, ATR(14).
htf(string tf) =>
    request.security(syminfo.tickerid, tf, [low[1] > high[3], high[1] < low[3], low[1], high[3], low[3], high[1], time[1], time[3],
         math.abs(close[2] - open[2]), high[2] - low[2], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)

// ───────────────────────── Per-bar work ─────────────────────────
inWindow = bar_index > last_bar_index - maxBack
chartSec = timeframe.in_seconds(timeframe.period)
atrC     = ta.atr(14)

// Events for alerts, reset every bar.
evEnter = false
fvgRetBull = false   // a candle came back into a live bullish gap (without closing through it)
fvgRetBear = false
evCE    = false
evInv   = false

// 1. Update the zones we already have (before adding this bar's new ones).
if barstate.isconfirmed and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        z = array.get(zones, i)
        if z.state == "FILLED"
            continue
        if extendMode == "Until removed"
            box.set_right(z.bx, time)
            if not na(z.ce)
                line.set_x2(z.ce, time)
            if not na(z.lb)
                label.set_x(z.lb, time)
        far  = z.dir == 1 ? z.bot : z.top
        near = z.dir == 1 ? z.top : z.bot
        mid  = (z.top + z.bot) / 2
        wickFar     = z.dir == 1 ? low <= far   : high >= far
        bodyThrough = z.dir == 1 ? close <= far : close >= far
        touchedMid  = z.dir == 1 ? low <= mid   : high >= mid
        entered     = z.dir == 1 ? low <= near  : high >= near
        isFilled    = fillMode == "Wick" ? wickFar : bodyThrough
        if entered and not bodyThrough
            if z.dir == 1
                fvgRetBull := true
            else
                fvgRetBear := true
        if bodyThrough and z.inverted
            kill(z)
            array.remove(zones, i)
        else if bodyThrough and showInv
            invert(z)
            evInv := true
        else if isFilled
            if onFilled == "Delete"
                kill(z)
                array.remove(zones, i)
            else
                dim(z)
        else if touchedMid and z.state != "CE"
            z.state := "CE"
            evCE := true
        else if entered and z.state == "FRESH"
            z.state := "PARTIAL"
            evEnter := true

// 2. Chart-timeframe gaps. Candle 1 = [2], candle 2 = [1], candle 3 = [0].
curBull = low > high[2]
curBear = high < low[2]
body2   = math.abs(close[1] - open[1])
range2  = high[1] - low[1]

// Buy/sell volume of each candle, from a lower timeframe about 10x faster than the chart (1 minute at least).
lowerTf  = str.tostring(math.max(1, math.ceil(timeframe.in_seconds(timeframe.period) / 60 / 10)))
buyArr   = request.security_lower_tf(syminfo.tickerid, lowerTf, close > open ? volume : 0.0)
sellArr  = request.security_lower_tf(syminfo.tickerid, lowerTf, close < open ? volume : 0.0)
buyVol   = array.sum(buyArr)
sellVol  = array.sum(sellArr)
bsTotal  = buyVol + sellVol
buyShare = bsTotal > 0 ? buyVol / bsTotal * 100 : na
// middle candle = [1]; if the lower timeframe has no data, fall back to the candle's own volume for the total
midBuy   = buyShare[1]
midTot   = bsTotal[1] > 0 ? bsTotal[1] : volume[1]

// Optional relative size filter: gap size vs the biggest gap of the last 1000 bars.
gapSz    = curBull ? low - high[2] : curBear ? low[2] - high : 0.0
bigGap   = ta.highest(gapSz, 1000)
sizeOk   = relSize == 0 or (bigGap > 0 and gapSz / bigGap * 100 >= relSize)

if barstate.isconfirmed and inWindow and sizeOk
    if curBull and passes(low, high[2], body2, range2, atrC)
        newZone(low, high[2], 1, "", time[2], midBuy, midTot)
    if curBear and passes(low[2], high, body2, range2, atrC)
        newZone(low[2], high, -1, "", time[2], midBuy, midTot)

// Dashboard: live gaps per side and their summed volume.
var dash = table.new(position.top_right, 3, 3, bgcolor = color.new(chart.bg_color, 10), border_width = 1)
if showDash and barstate.islast
    nB = 0
    nS = 0
    vB = 0.0
    vS = 0.0
    for z in zones
        if z.state != "FILLED"
            if z.dir == 1
                nB += 1
                vB += nz(z.totVol)
            else
                nS += 1
                vS += nz(z.totVol)
    table.cell(dash, 0, 0, "FVG", text_color = chart.fg_color, text_size = size.small)
    table.cell(dash, 1, 0, "On chart", text_color = chart.fg_color, text_size = size.small)
    table.cell(dash, 2, 0, "Total volume", text_color = chart.fg_color, text_size = size.small)
    table.cell(dash, 0, 1, "Bullish", text_color = bullCol, text_size = size.small)
    table.cell(dash, 1, 1, str.tostring(nB), text_color = chart.fg_color, text_size = size.small)
    table.cell(dash, 2, 1, str.tostring(vB, format.volume), text_color = chart.fg_color, text_size = size.small)
    table.cell(dash, 0, 2, "Bearish", text_color = bearCol, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(nS), text_color = chart.fg_color, text_size = size.small)
    table.cell(dash, 2, 2, str.tostring(vS, format.volume), text_color = chart.fg_color, text_size = size.small)

// 3. Higher-timeframe gaps. Fetched every bar (Pine needs that), drawn once per new higher-timeframe bar.
[b1, r1, bT1, bB1, rT1, rB1, t1, l1, bd1, rg1, a1] = htf(tf1)
[b2, r2, bT2, bB2, rT2, rB2, t2, l2, bd2, rg2, a2] = htf(tf2)
[b3, r3, bT3, bB3, rT3, rB3, t3, l3, bd3, rg3, a3] = htf(tf3)
[b4, r4, bT4, bB4, rT4, rB4, t4, l4, bd4, rg4, a4] = htf(tf4)
n1 = ta.change(t1) != 0
n2 = ta.change(t2) != 0
n3 = ta.change(t3) != 0
n4 = ta.change(t4) != 0

drawHtf(string tf, bool show, bool isNew, bool isBull, bool isBear, float bTop, float bBot, float rTop, float rBot, int leftT, float bd, float rg, float av) =>
    if show and isNew and barstate.isconfirmed and inWindow and timeframe.in_seconds(tf) > chartSec
        if isBull and passes(bTop, bBot, bd, rg, av)
            newZone(bTop, bBot, 1, tfLabel(tf), leftT)
        if isBear and passes(rTop, rBot, bd, rg, av)
            newZone(rTop, rBot, -1, tfLabel(tf), leftT)

drawHtf(tf1, s1, n1, b1, r1, bT1, bB1, rT1, rB1, l1, bd1, rg1, a1)
drawHtf(tf2, s2, n2, b2, r2, bT2, bB2, rT2, rB2, l2, bd2, rg2, a2)
drawHtf(tf3, s3, n3, b3, r3, bT3, bB3, rT3, rB3, l3, bd3, rg3, a3)
drawHtf(tf4, s4, n4, b4, r4, bT4, bB4, rT4, rB4, l4, bd4, rg4, a4)

// 4. Keep the last N live gaps per direction, oldest out first; cap the total so drawings stay under TradingView's limit.
trimDir(int d) =>
    cnt = 0
    for z in zones
        if z.dir == d and z.state != "FILLED"
            cnt += 1
    if cnt > maxPerDir
        for i = 0 to array.size(zones) - 1
            z = array.get(zones, i)
            if z.dir == d and z.state != "FILLED"
                kill(z)
                array.remove(zones, i)
                break

if barstate.isconfirmed
    trimDir(1)
    trimDir(-1)
while array.size(zones) > 150
    kill(array.shift(zones))

// ───────────────────────── Alerts (for the notification bot later) ─────────────────────────
alertcondition(curBull, "New bullish FVG", "A new bullish fair value gap formed on the chart timeframe")
alertcondition(curBear, "New bearish FVG", "A new bearish fair value gap formed on the chart timeframe")
alertcondition(evEnter, "Price entered an FVG", "A wick entered a fair value gap")
alertcondition(evCE, "Price touched a midpoint", "A wick reached the midpoint (CE) of a fair value gap")
alertcondition(evInv, "FVG inverted", "A candle body closed through a fair value gap; it is now an inverted gap")

// ═════════════════════════ PART 2: ORDER BLOCKS ═════════════════════════

// ───────────────────────── Inputs ─────────────────────────
gOS = "Order blocks: structure"
swingLen   = input.int(3, "Swing length", minval = 1, maxval = 50, group = gOS,
     tooltip = "A swing high needs this many lower highs on each side (a swing low, higher lows). 3 reads shifts the way the eye does on 5m; 5 waits for bigger turns and makes fewer blocks.")
maxLeg     = input.int(10, "Max candles in the leg", minval = 1, maxval = 50, group = gOS,
     tooltip = "How far back from the turning candle the down leg (or up leg) may reach.")
dispMin    = input.float(2.0, "Displacement, min size x ATR(14)", minval = 0, step = 0.5, group = gOS,
     tooltip = "The move from the sweep (turning extreme) to the breaking close must be at least this many ATRs. 0 = any size. Keeps out breaks made by a few small candles.")
needSweep  = input.bool(false, "Require a liquidity sweep", group = gOS,
     tooltip = "Only make a block if the turning low took out the previous swing low (high for bearish).")
onContin   = input.bool(false, "Also make blocks on continuation breaks", group = gOS,
     tooltip = "Off = one block per trend: a new one only forms after another shift (the rule). On = every break of structure can make a block.")

gOB = "Order blocks: boxes"
mitigation = input.string("Close", "Invalidated when", options = ["Close", "Wick"], group = gOB,
     tooltip = "Close: a candle closes through the far side. Wick: any wick through the far side.")
keepPerDir = input.int(1, "Blocks kept per direction", minval = 1, maxval = 10, group = gOB)
obExtend = input.int(20, "Extend past current bar", minval = 0, maxval = 400, group = gOB)
showMid    = input.bool(true, "Midpoint line", group = gOB)
obLabels = input.bool(true, "Labels", group = gOB)
showBreaks = input.bool(false, "Show structure breaks", group = gOB,
     tooltip = "Dotted line at each broken swing, labelled Shift (trend change) or BOS (continuation).")

gOC = "Order blocks: colors"
obBullCol = input.color(#9c27b0, "Bullish block", group = gOC)
obBearCol = input.color(#ff9800, "Bearish block", group = gOC)
obTransp  = input.int(80, "Box transparency", minval = 0, maxval = 100, group = gOC)
midCol  = input.color(#9598a1, "Midpoint line", group = gOC)

// ───────────────────────── Types ─────────────────────────
type OB
    box   bx
    line  mid
    label lb
    float top
    float bot
    int   dir      // +1 bullish (support), -1 bearish (resistance)
    bool  touched
    bool  fired    // a setup signal already fired from this block
    int   madeIdx  // bar the block was made on
    int   leftIdx  // first candle of the block
    bool  grow     // bearish block still adding red candles of the drop

var obs = array.new<OB>()

killOB(OB o) =>
    box.delete(o.bx)
    line.delete(o.mid)
    label.delete(o.lb)

obAtr = ta.atr(14)

// ───────────────────────── Swings ─────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float swHi = na
var int   swHiIdx = na
var bool  swHiBroken = true
var float prevSwHi = na
var float swLo = na
var int   swLoIdx = na
var bool  swLoBroken = true
var float prevSwLo = na
var int   trend = 0
var int   bullBreakIdx = na   // bar where the current up-trend began (last bullish shift)
var int   bearBreakIdx = na   // bar where the current down-trend began (last bearish shift)

if not na(ph)
    prevSwHi   := swHi
    swHi       := ph
    swHiIdx    := bar_index - swingLen
    swHiBroken := false
if not na(pl)
    prevSwLo   := swLo
    swLo       := pl
    swLoIdx    := bar_index - swingLen
    swLoBroken := false

// ───────────────────────── Helpers ─────────────────────────
// Find the order block for a SHIFT (the user's definition, 17 Nov 2026; see research/NOTE_order_block_indicator.md):
//   The order block is the LEG of price immediately before the liquidity sweep: the range where the big orders
//   got filled. One block per trend; a new one only forms after another shift.
//   - The sweep is the turning extreme of the trend being reversed (lowest low before a bullish shift, highest
//     high before a bearish one).
//   - The leg is the run of opposing candles going INTO that extreme: red candles into the low (bullish block),
//     green candles into the high (bearish block). A turning candle that already closes the other way (a reversal
//     candle with a long wick) is the sweep itself, not part of the leg, so it is left out.
//   - The move away (from the extreme to the breaking close) must be a strong displacement: at least `dispMin`
//     x ATR(14), not a few small candles.
// Returns [top, bottom, offset of the oldest leg candle, (unused), turning price, offset of turning candle].
findLeg(int dir, int span) =>
    // the breaking candle (k = 0) is the displacement, never the turning point
    turnOff = 1
    turnVal = dir == 1 ? low[1] : high[1]
    for k = 1 to math.max(span, 1)
        v = dir == 1 ? low[k] : high[k]
        if (dir == 1 and v < turnVal) or (dir == -1 and v > turnVal)
            turnVal := v
            turnOff := k
    float top = na
    float bot = na
    int   first = na
    int   cnt = 0
    k = (dir == 1 ? close[turnOff] < open[turnOff] : close[turnOff] > open[turnOff]) ? turnOff : turnOff + 1
    while k <= span and cnt < maxLeg and (dir == 1 ? close[k] < open[k] : close[k] > open[k])
        top := na(top) ? high[k] : math.max(top, high[k])
        bot := na(bot) ? low[k] : math.min(bot, low[k])
        first := k
        cnt += 1
        k += 1
    if cnt == 0
        // no opposing candles before the sweep: use the sweep candle itself
        top := high[turnOff]
        bot := low[turnOff]
        first := turnOff
    moveSz = dir == 1 ? close - turnVal : turnVal - close
    if moveSz < dispMin * obAtr
        first := na
    [top, bot, first, false, turnVal, turnOff]

// A new block sitting completely inside a live block of the same direction adds nothing, so it is skipped.
nested(int dir, float top, float bot) =>
    inside = false
    for o in obs
        if o.dir == dir and o.bot <= bot and o.top >= top
            inside := true
    inside

makeOB(int dir, float top, float bot, int leftIdx, bool growing) =>
    // one block per trend: drop the oldest of this direction once the limit is reached
    cnt = 0
    for o in obs
        if o.dir == dir
            cnt += 1
    while cnt >= keepPerDir
        for i = 0 to array.size(obs) - 1
            o = array.get(obs, i)
            if o.dir == dir
                killOB(o)
                array.remove(obs, i)
                break
        cnt -= 1
    col = dir == 1 ? obBullCol : obBearCol
    rightIdx = bar_index + obExtend
    mid = (top + bot) / 2
    bx = box.new(leftIdx, top, rightIdx, bot, border_color = color.new(col, 0), border_width = 1,
         bgcolor = color.new(col, obTransp))
    line ml = na
    if showMid
        ml := line.new(leftIdx, mid, rightIdx, mid, color = color.new(midCol, 30), style = line.style_dashed)
    label lb = na
    if obLabels
        lb := label.new(rightIdx, mid, dir == 1 ? "Bull OB" : "Bear OB", style = label.style_label_left,
             color = color.new(color.black, 100), textcolor = color.new(col, 0), size = size.small)
    array.push(obs, OB.new(bx, ml, lb, top, bot, dir, false, false, bar_index, leftIdx, growing))

drawBreak(int fromIdx, float level, bool isShift, int dir) =>
    if showBreaks
        col = dir == 1 ? obBullCol : obBearCol
        line.new(fromIdx, level, bar_index, level, color = color.new(col, 20), style = line.style_dotted)
        label.new(math.round((fromIdx + bar_index) / 2), level, isShift ? "Shift" : "BOS",
             style = dir == 1 ? label.style_label_down : label.style_label_up,
             color = color.new(color.black, 100), textcolor = col, size = size.tiny)

// ───────────────────────── Per-bar work ─────────────────────────
evBullNew = false
evBearNew = false
evOBEnter   = false
obRetBull   = false   // a candle came back into the live bullish order block
obRetBear   = false
evGone    = false

// 1. Update existing blocks first (a block made on this bar is not tested against its own bar).
if barstate.isconfirmed and array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        if o.grow
            // bearish block: the drop is still going (another red candle), so the box grows down with it
            if close < open and bar_index - o.leftIdx < maxLeg
                o.bot := math.min(o.bot, low)
                o.top := math.max(o.top, high)
                box.set_bottom(o.bx, o.bot)
                box.set_top(o.bx, o.top)
                m = (o.top + o.bot) / 2
                if not na(o.mid)
                    line.set_y1(o.mid, m)
                    line.set_y2(o.mid, m)
                if not na(o.lb)
                    label.set_y(o.lb, m)
            else
                o.grow := false
        through = o.dir == 1 ? (mitigation == "Close" ? close < o.bot : low < o.bot) : (mitigation == "Close" ? close > o.top : high > o.top)
        if through
            killOB(o)
            array.remove(obs, i)
            evGone := true
        else
            box.set_right(o.bx, bar_index + obExtend)
            if not na(o.mid)
                line.set_x2(o.mid, bar_index + obExtend)
            if not na(o.lb)
                label.set_x(o.lb, bar_index + obExtend)
            inside = o.dir == 1 ? low <= o.top : high >= o.bot
            if inside
                if o.dir == 1
                    obRetBull := true
                else
                    obRetBear := true
            if inside and not o.touched
                o.touched := true
                evOBEnter := true

// 2. Structure breaks and new blocks.
if barstate.isconfirmed
    if not swHiBroken and not na(swHi) and close > swHi
        swHiBroken := true
        isShift = trend != 1
        trend := 1
        drawBreak(swHiIdx, swHi, isShift, 1)
        if isShift or onContin
            // look back across the whole down-trend being reversed, so the block sits on the leg into its true low
            fromIdx = isShift and not na(bearBreakIdx) ? math.min(swHiIdx, bearBreakIdx) : swHiIdx
            span = math.min(bar_index - fromIdx, 500)
            [t, b, legStart, gr, turnVal, turnOff] = findLeg(1, span)
            refLow = (not na(swLoIdx) and bar_index - swLoIdx == turnOff) ? prevSwLo : swLo
            swept  = not na(refLow) and turnVal < refLow
            if not na(legStart) and (not needSweep or swept) and not nested(1, t, b)
                makeOB(1, t, b, bar_index - legStart, gr)
                evBullNew := true
        if isShift
            bullBreakIdx := bar_index
    if not swLoBroken and not na(swLo) and close < swLo
        swLoBroken := true
        isShift = trend != -1
        trend := -1
        drawBreak(swLoIdx, swLo, isShift, -1)
        if isShift or onContin
            // look back across the whole up-trend being reversed, so the block sits on the leg into its true high
            fromIdx = isShift and not na(bullBreakIdx) ? math.min(swLoIdx, bullBreakIdx) : swLoIdx
            span = math.min(bar_index - fromIdx, 500)
            [t, b, legStart, gr, turnVal, turnOff] = findLeg(-1, span)
            refHigh = (not na(swHiIdx) and bar_index - swHiIdx == turnOff) ? prevSwHi : swHi
            swept   = not na(refHigh) and turnVal > refHigh
            if not na(legStart) and (not needSweep or swept) and not nested(-1, t, b)
                makeOB(-1, t, b, bar_index - legStart, gr)
                evBearNew := true
        if isShift
            bearBreakIdx := bar_index

// ───────────────────────── Alerts (for the notification bot later) ─────────────────────────
alertcondition(evBullNew, "Bullish OB formed", "Bullish shift: a new bullish order block formed")
alertcondition(evBearNew, "Bearish OB formed", "Bearish shift: a new bearish order block formed")
alertcondition(evOBEnter, "Price returned to an OB", "Price came back into an order block")
alertcondition(evGone, "OB invalidated", "A candle went through an order block; it was removed")

// ═════════════════════════ PART 3: SWING LIQUIDITY ═════════════════════════
// Big swing highs and lows are where stop orders pile up (liquidity). Each one gets a dotted line and a thin
// box that extend right until price trades through the level (the liquidity is "taken" / swept). Then the
// level stops extending and stays on the chart as history (or is hidden, a setting).
gL = "Liquidity: swing points"
liqRight   = input.int(10, "Candles right of the swing", minval = 1, maxval = 50, group = gL)
liqLeft    = input.int(15, "Candles left of the swing", minval = 1, maxval = 50, group = gL,
     tooltip = "A swing high must be the highest high of this many candles before it and the right number after it. Big numbers = only major levels. It is confirmed only after the right-side candles close.")
liqShow    = input.bool(true, "Show liquidity levels", group = gL)
liqBoxes   = input.bool(true, "Boxes", group = gL)
liqDots    = input.bool(true, "Circle on each swing", group = gL)
liqVolTxt  = input.bool(false, "Swing candle volume text", group = gL)
liqHide    = input.bool(false, "Hide levels once taken", group = gL)
liqBoxPct  = input.float(0.07, "Box height, % of price", minval = 0, step = 0.01, group = gL)
liqMinVol  = input.float(0, "Only swings with volume above", minval = 0, group = gL)
liqHiCol   = input.color(#aa2430, "Swing highs (liquidity above)", group = gL)
liqLoCol   = input.color(#66bb6a, "Swing lows (liquidity below)", group = gL)

type Liq
    line  ln
    box   bx
    float level
    int   dir      // +1 = swing high (buy stops above), -1 = swing low (sell stops below)

var liqs = array.new<Liq>()
var int lastHighSweepIdx = na   // last bar that took out a swing-high level
var int lastLowSweepIdx  = na   // last bar that took out a swing-low level
evLiqHi = false
evLiqLo = false

lPivHi = ta.pivothigh(high, liqLeft, liqRight)
lPivLo = ta.pivotlow(low, liqLeft, liqRight)
lVol   = volume[liqRight]
lVolOk = liqMinVol == 0 or lVol > liqMinVol

newLiq(float lvl, int dir) =>
    col  = dir == 1 ? liqHiCol : liqLoCol
    from = bar_index - liqRight
    edge = dir == 1 ? lvl * (1 + liqBoxPct / 100) : lvl * (1 - liqBoxPct / 100)
    box b = na
    if liqShow and liqBoxes
        b := box.new(from, math.max(lvl, edge), bar_index, math.min(lvl, edge), border_color = na,
             bgcolor = color.new(col, 80), text = liqVolTxt ? str.tostring(lVol, format.volume) : "",
             text_size = size.tiny, text_color = chart.fg_color, text_halign = text.align_right)
    line l = na
    if liqShow
        l := line.new(from, lvl, bar_index, lvl, color = col, style = line.style_dotted)
    array.push(liqs, Liq.new(l, b, lvl, dir))

if barstate.isconfirmed
    // check the levels we already have first, so a new level is not tested against its own candle
    if array.size(liqs) > 0
        for i = array.size(liqs) - 1 to 0
            q = array.get(liqs, i)
            taken = q.dir == 1 ? high >= q.level : low <= q.level
            if taken
                if q.dir == 1
                    lastHighSweepIdx := bar_index
                    evLiqHi := true
                else
                    lastLowSweepIdx := bar_index
                    evLiqLo := true
                line.set_x2(q.ln, bar_index)
                box.set_right(q.bx, bar_index)
                if liqHide
                    line.delete(q.ln)
                    box.delete(q.bx)
                array.remove(liqs, i)
            else
                line.set_x2(q.ln, bar_index + 1)
                box.set_right(q.bx, bar_index + 1)
    if not na(lPivHi) and lVolOk
        newLiq(lPivHi, 1)
    if not na(lPivLo) and lVolOk
        newLiq(lPivLo, -1)
    while array.size(liqs) > 100
        q = array.shift(liqs)
        line.delete(q.ln)
        box.delete(q.bx)

plotshape(liqShow and liqDots and not na(lPivHi) and lVolOk ? lPivHi : na, "Swing high", shape.circle,
     location.absolute, liqHiCol, offset = -liqRight, size = size.tiny)
plotshape(liqShow and liqDots and not na(lPivLo) and lVolOk ? lPivLo : na, "Swing low", shape.circle,
     location.absolute, liqLoCol, offset = -liqRight, size = size.tiny)
alertcondition(evLiqHi, "Liquidity above taken", "Price traded through a swing-high liquidity level")
alertcondition(evLiqLo, "Liquidity below taken", "Price traded through a swing-low liquidity level")

// ═════════════════════════ PART 4: MARKET STRUCTURE ═════════════════════════
// Own build of the structure ideas in LuxAlgo's "Smart Money Concepts" (their order blocks, equal highs/lows and
// fair value gaps are left out: parts 1 to 3 already cover those).
//   - Swings: a swing high is a high that no candle beats for `size` candles after it (a swing low, the mirror).
//   - BOS (break of structure): a candle BODY closes beyond the most recent swing high (bullish) or swing low
//     (bearish). Wicks never count. In an up-trend you watch the lows, in a down-trend the highs.
//   - CHoCH (market structure shift): the first BOS against the trend RIGHT AFTER A LIQUIDITY SWEEP (a part 3
//     liquidity level taken within the last few candles). A break against the trend without a sweep still turns
//     the trend but is labelled BOS.
//   - "Swing" structure uses big swings (50 candles), "internal" uses small ones (5 candles).
//   - Strong/weak high and low: the extremes of the current swing range. In a down-trend the high is "strong"
//     (it made the lows) and the low is "weak" (likely to break); the other way round in an up-trend.
//   - Premium/discount: top 5% of that range is premium (sell area), bottom 5% discount (buy area), middle equilibrium.
// Decided on closed candles only, so nothing repaints. Old breaks are deleted so the chart stays readable.
gM  = "Structure: BOS / CHoCH"
msOnlyConf = input.bool(true, "Only show confirmed BOS / CHoCH", group = gM,
     tooltip = "On: only breaks that come after a liquidity sweep or order block AND a pullback into a fair value gap or order block are drawn, and only the most recent few. Off: every break is drawn.")
msSwingOn  = input.bool(true, "Swing structure (big turns)", group = gM)
msSwingLen = input.int(50, "Swing size, candles", minval = 10, maxval = 200, group = gM)
msIntOn    = input.bool(true, "Internal structure (small turns)", group = gM,
     tooltip = "Small BOS/CHoCH (dashed) inside the big swings. These are the short-term breaks TJR trades.")
msIntLen   = input.int(3, "Internal size, candles", minval = 2, maxval = 20, group = gM,
     tooltip = "A small swing low needs this many higher lows after it (a high, lower highs). 3 catches the pullback lows you mark on 5m.")
msKeep     = input.int(30, "Breaks kept on the chart (each kind)", minval = 1, maxval = 50, group = gM)
msNeedSw   = input.bool(true, "CHoCH needs a liquidity sweep", group = gM,
     tooltip = "On: a break against the trend is only called CHoCH if a liquidity level (part 3) was taken shortly before it. Off: every break against the trend is a CHoCH.")
msSwWin    = input.int(20, "Sweep window, candles before the break", minval = 1, maxval = 200, group = gM)
msPoints   = input.bool(false, "Swing labels (HH, HL, LH, LL)", group = gM)
msBullCol  = input.color(#089981, "Bullish", group = gM)
msBearCol  = input.color(#F23645, "Bearish", group = gM)

gMZ = "Structure: range and zones"
msStrong   = input.bool(true, "Strong / weak high and low", group = gMZ)
msZones    = input.bool(false, "Premium / discount zones", group = gMZ)
msEqCol    = input.color(#878b94, "Equilibrium zone", group = gMZ)
msCandles  = input.bool(false, "Colour candles by internal trend", group = gMZ)

gML = "Structure: previous day / week / month high and low"
lvlD   = input.bool(false, "Previous day", group = gML)
lvlW   = input.bool(false, "Previous week", group = gML)
lvlM   = input.bool(false, "Previous month", group = gML)
lvlCol = input.color(#2157f3, "Colour", group = gML)

type MsPivot
    float level
    float last
    bool  crossed
    int   t
    int   idx

var MsPivot sHi = MsPivot.new(na, na, true, na, na)
var MsPivot sLo = MsPivot.new(na, na, true, na, na)
var MsPivot iHi = MsPivot.new(na, na, true, na, na)
var MsPivot iLo = MsPivot.new(na, na, true, na, na)
var int sTrend = 0      // swing trend: +1 up, -1 down
var int iTrend = 0      // internal trend
var sLines  = array.new<line>()
var sLabels = array.new<label>()
var iLines  = array.new<line>()
var iLabels = array.new<label>()
// range for strong/weak and zones
var float rTop = na
var int   rTopT = na
var float rBot = na
var int   rBotT = na
var int   rStartT = na
var int   rStartIdx = na
evSBos = 0
evSChoch = 0
evIBos = 0
evIChoch = 0

// leg: 0 after a new swing high (price now falling), 1 after a new swing low
msLeg(int size) =>
    var int lg = 0
    hh = ta.highest(size)
    ll = ta.lowest(size)
    if high[size] > hh
        lg := 0
    else if low[size] < ll
        lg := 1
    lg

sLeg = msLeg(msSwingLen)
iLeg = msLeg(msIntLen)
sNewLow  = ta.change(sLeg) == 1
sNewHigh = ta.change(sLeg) == -1
iNewLow  = ta.change(iLeg) == 1
iNewHigh = ta.change(iLeg) == -1

setPivot(MsPivot p, float lvl, int size) =>
    p.last    := p.level
    p.level   := lvl
    p.crossed := false
    p.t       := time[size]
    p.idx     := bar_index - size

if sNewLow
    setPivot(sLo, low[msSwingLen], msSwingLen)
    rBot := sLo.level, rBotT := sLo.t, rStartT := sLo.t, rStartIdx := sLo.idx
    if msPoints
        label.new(sLo.t, sLo.level, na(sLo.last) or sLo.level < sLo.last ? "LL" : "HL", xloc = xloc.bar_time,
             style = label.style_label_up, color = color(na), textcolor = msBullCol, size = size.tiny)
if sNewHigh
    setPivot(sHi, high[msSwingLen], msSwingLen)
    rTop := sHi.level, rTopT := sHi.t, rStartT := sHi.t, rStartIdx := sHi.idx
    if msPoints
        label.new(sHi.t, sHi.level, na(sHi.last) or sHi.level > sHi.last ? "HH" : "LH", xloc = xloc.bar_time,
             style = label.style_label_down, color = color(na), textcolor = msBearCol, size = size.tiny)
if iNewLow
    setPivot(iLo, low[msIntLen], msIntLen)
if iNewHigh
    setPivot(iHi, high[msIntLen], msIntLen)

// keep the range extremes up to date
if na(rTop) or high > rTop
    rTop := high, rTopT := time
if na(rBot) or low < rBot
    rBot := low, rBotT := time

// was liquidity on this side taken shortly before now? dir +1: a low was swept (sets up a bullish CHoCH)
sweptBefore(int dir) =>
    idx = dir == 1 ? lastLowSweepIdx : lastHighSweepIdx
    not msNeedSw or (not na(idx) and bar_index - idx <= msSwWin)

drawBreak4(MsPivot p, string tag, color col, bool small, bool up, array<line> ls, array<label> lbs) =>
    ls.push(line.new(p.t, p.level, time, p.level, xloc = xloc.bar_time, color = col,
         style = small ? line.style_dashed : line.style_solid))
    lbs.push(label.new(math.round((p.idx + bar_index) / 2), p.level, tag, color = color(na), textcolor = col,
         style = up ? label.style_label_down : label.style_label_up, size = small ? size.tiny : size.small))
    while ls.size() > msKeep
        line.delete(ls.shift())
        label.delete(lbs.shift())

if barstate.isconfirmed
    // internal first (small swings), skipping levels that are also the swing level
    if not iHi.crossed and not na(iHi.level) and close > iHi.level and iHi.level != sHi.level
        iHi.crossed := true
        tag = iTrend == -1 and sweptBefore(1) ? "CHoCH" : "BOS"
        evIChoch := tag == "CHoCH" ? 1 : evIChoch
        evIBos   := tag == "BOS" ? 1 : evIBos
        iTrend := 1
        if msIntOn and not msOnlyConf
            drawBreak4(iHi, tag, msBullCol, true, true, iLines, iLabels)
    if not iLo.crossed and not na(iLo.level) and close < iLo.level and iLo.level != sLo.level
        iLo.crossed := true
        tag = iTrend == 1 and sweptBefore(-1) ? "CHoCH" : "BOS"
        evIChoch := tag == "CHoCH" ? -1 : evIChoch
        evIBos   := tag == "BOS" ? -1 : evIBos
        iTrend := -1
        if msIntOn and not msOnlyConf
            drawBreak4(iLo, tag, msBearCol, true, false, iLines, iLabels)
    if not sHi.crossed and not na(sHi.level) and close > sHi.level
        sHi.crossed := true
        tag = sTrend == -1 and sweptBefore(1) ? "CHoCH" : "BOS"
        evSChoch := tag == "CHoCH" ? 1 : evSChoch
        evSBos   := tag == "BOS" ? 1 : evSBos
        sTrend := 1
        if msSwingOn and not msOnlyConf
            drawBreak4(sHi, tag, msBullCol, false, true, sLines, sLabels)
    if not sLo.crossed and not na(sLo.level) and close < sLo.level
        sLo.crossed := true
        tag = sTrend == 1 and sweptBefore(-1) ? "CHoCH" : "BOS"
        evSChoch := tag == "CHoCH" ? -1 : evSChoch
        evSBos   := tag == "BOS" ? -1 : evSBos
        sTrend := -1
        if msSwingOn and not msOnlyConf
            drawBreak4(sLo, tag, msBearCol, false, false, sLines, sLabels)

// strong / weak high and low, premium / discount zones (drawn once, on the last bar)
var line  swHiLn = na
var line  swLoLn = na
var label swHiLb = na
var label swLoLb = na
var box   zPrem = na
var box   zEq   = na
var box   zDisc = na
if barstate.islast and not na(rTop) and not na(rBot)
    rightT = time + 20 * (time - time[1])
    line.delete(swHiLn), line.delete(swLoLn), label.delete(swHiLb), label.delete(swLoLb)
    box.delete(zPrem), box.delete(zEq), box.delete(zDisc)
    if msStrong
        swHiLn := line.new(rTopT, rTop, rightT, rTop, xloc = xloc.bar_time, color = msBearCol)
        swHiLb := label.new(rightT, rTop, sTrend == -1 ? "Strong High" : "Weak High", xloc = xloc.bar_time,
             style = label.style_label_left, color = color(na), textcolor = msBearCol, size = size.tiny)
        swLoLn := line.new(rBotT, rBot, rightT, rBot, xloc = xloc.bar_time, color = msBullCol)
        swLoLb := label.new(rightT, rBot, sTrend == 1 ? "Strong Low" : "Weak Low", xloc = xloc.bar_time,
             style = label.style_label_left, color = color(na), textcolor = msBullCol, size = size.tiny)
    if msZones and not na(rStartT)
        zPrem := box.new(rStartT, rTop, time, 0.95 * rTop + 0.05 * rBot, xloc = xloc.bar_time, border_color = color(na),
             bgcolor = color.new(msBearCol, 80), text = "Premium", text_size = size.tiny, text_color = msBearCol)
        zEq   := box.new(rStartT, 0.525 * rTop + 0.475 * rBot, time, 0.525 * rBot + 0.475 * rTop, xloc = xloc.bar_time,
             border_color = color(na), bgcolor = color.new(msEqCol, 80), text = "Equilibrium", text_size = size.tiny, text_color = msEqCol)
        zDisc := box.new(rStartT, 0.95 * rBot + 0.05 * rTop, time, rBot, xloc = xloc.bar_time, border_color = color(na),
             bgcolor = color.new(msBullCol, 80), text = "Discount", text_size = size.tiny, text_color = msBullCol)

plotcandle(msCandles ? open : na, high, low, close, "Trend candles", color = iTrend == 1 ? msBullCol : msBearCol,
     wickcolor = iTrend == 1 ? msBullCol : msBearCol, bordercolor = iTrend == 1 ? msBullCol : msBearCol, display = display.pane)

// previous day / week / month high and low
prevLevels(string tf) =>
    request.security(syminfo.tickerid, tf, [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[pdH, pdL, pdT] = prevLevels("D")
[pwH, pwL, pwT] = prevLevels("W")
[pmH, pmL, pmT] = prevLevels("M")
var lvlLines  = array.new<line>()
var lvlLabels = array.new<label>()
drawLvl(bool show, string tf, float hi, float lo, int t, string name) =>
    if show and timeframe.in_seconds() < timeframe.in_seconds(tf) and not na(hi)
        rightT = time + 20 * (time - time[1])
        lvlLines.push(line.new(t, hi, rightT, hi, xloc = xloc.bar_time, color = lvlCol))
        lvlLines.push(line.new(t, lo, rightT, lo, xloc = xloc.bar_time, color = lvlCol))
        lvlLabels.push(label.new(rightT, hi, "P" + name + "H", xloc = xloc.bar_time, style = label.style_label_left,
             color = color(na), textcolor = lvlCol, size = size.tiny))
        lvlLabels.push(label.new(rightT, lo, "P" + name + "L", xloc = xloc.bar_time, style = label.style_label_left,
             color = color(na), textcolor = lvlCol, size = size.tiny))
if barstate.islast
    for l in lvlLines
        line.delete(l)
    for l in lvlLabels
        label.delete(l)
    lvlLines.clear()
    lvlLabels.clear()
    drawLvl(lvlD, "D", pdH, pdL, pdT, "D")
    drawLvl(lvlW, "W", pwH, pwL, pwT, "W")
    drawLvl(lvlM, "M", pmH, pmL, pmT, "M")

alertcondition(evSBos == 1,   "Swing bullish BOS",   "Bullish break of structure (swing)")
alertcondition(evSBos == -1,  "Swing bearish BOS",   "Bearish break of structure (swing)")
alertcondition(evSChoch == 1, "Swing bullish CHoCH", "Bullish change of character (swing)")
alertcondition(evSChoch == -1,"Swing bearish CHoCH", "Bearish change of character (swing)")
alertcondition(evIBos == 1,   "Internal bullish BOS",   "Bullish break of structure (internal)")
alertcondition(evIBos == -1,  "Internal bearish BOS",   "Bearish break of structure (internal)")
alertcondition(evIChoch == 1, "Internal bullish CHoCH", "Bullish change of character (internal)")
alertcondition(evIChoch == -1,"Internal bearish CHoCH", "Bearish change of character (internal)")

// ═════════════════════════ CONFIRMED BOS (the trade trigger) ═════════════════════════
// Only signals a BOS when the full sequence happened, in this order (bullish; bearish is the mirror):
//   1. ANCHOR: liquidity below was swept (part 3 level taken) or a new bullish order block formed (part 2).
//   2. RETRACE: after that, price came back into a live bullish fair value gap (part 1) and/or the bullish
//      order block, without closing through it.
//   3. BOS: then a candle body closes above the most recent small swing high (part 4 internal structure).
// All three must happen within the window. After a signal the sequence resets.
gB2 = "Confirmed BOS signal"
cbShow   = input.bool(true, "Show confirmed BOS", group = gB2)
cbRetrOn = input.string("FVG or order block", "Retrace must reach", options = ["FVG or order block", "FVG only", "Order block only", "FVG and order block"], group = gB2)
cbWin    = input.int(40, "Window, candles from anchor to BOS", minval = 5, maxval = 300, group = gB2)
cbCol    = input.color(#2962ff, "Colour", group = gB2)
cbKeep   = input.int(4, "Confirmed breaks kept on the chart", minval = 1, maxval = 50, group = gB2)
var cbLines  = array.new<line>()
var cbLabels = array.new<label>()

var int cbBullAnchor = na
var int cbBearAnchor = na
var int cbBullFvg = na
var int cbBullOb  = na
var int cbBearFvg = na
var int cbBearOb  = na
cbLong  = false
cbShort = false

retOk(int f, int o) =>
    cbRetrOn == "FVG only" ? not na(f) : cbRetrOn == "Order block only" ? not na(o) : cbRetrOn == "FVG and order block" ? (not na(f) and not na(o)) : (not na(f) or not na(o))

if barstate.isconfirmed
    // 3. the BOS first (any internal break: BOS or CHoCH), after the retrace, inside the window.
    //    Checked before new anchors, because the same breaking candle often also creates a new order block.
    if (evIBos == 1 or evIChoch == 1) and not na(cbBullAnchor) and bar_index - cbBullAnchor <= cbWin and retOk(cbBullFvg, cbBullOb)
        cbLong := true
        cbBullAnchor := na, cbBullFvg := na, cbBullOb := na
    if (evIBos == -1 or evIChoch == -1) and not na(cbBearAnchor) and bar_index - cbBearAnchor <= cbWin and retOk(cbBearFvg, cbBearOb)
        cbShort := true
        cbBearAnchor := na, cbBearFvg := na, cbBearOb := na
    // expire stale sequences
    if not na(cbBullAnchor) and bar_index - cbBullAnchor > cbWin
        cbBullAnchor := na, cbBullFvg := na, cbBullOb := na
    if not na(cbBearAnchor) and bar_index - cbBearAnchor > cbWin
        cbBearAnchor := na, cbBearFvg := na, cbBearOb := na
    // 1. anchors: a sweep (re)starts the sequence; a new order block starts one only if none is running
    if evLiqLo or (evBullNew and na(cbBullAnchor))
        cbBullAnchor := bar_index, cbBullFvg := na, cbBullOb := na
    if evLiqHi or (evBearNew and na(cbBearAnchor))
        cbBearAnchor := bar_index, cbBearFvg := na, cbBearOb := na
    // 2. retraces after the anchor (not on the anchor candle itself)
    if not na(cbBullAnchor) and bar_index > cbBullAnchor
        if fvgRetBull
            cbBullFvg := bar_index
        if obRetBull
            cbBullOb := bar_index
    if not na(cbBearAnchor) and bar_index > cbBearAnchor
        if fvgRetBear
            cbBearFvg := bar_index
        if obRetBear
            cbBearOb := bar_index

// draw a confirmed break: line from the broken swing to the breaking candle, labelled BOS or CHoCH
if cbShow and (cbLong or cbShort)
    p   = cbLong ? iHi : iLo
    tag = (cbLong ? evIChoch == 1 : evIChoch == -1) ? "CHoCH" : "BOS"
    cbLines.push(line.new(p.t, p.level, time, p.level, xloc = xloc.bar_time, color = cbCol, width = 2))
    cbLabels.push(label.new(math.round((p.idx + bar_index) / 2), p.level, tag + " ✓", color = cbCol, textcolor = color.white,
         style = cbLong ? label.style_label_down : label.style_label_up, size = size.small))
    while cbLines.size() > cbKeep
        line.delete(cbLines.shift())
        label.delete(cbLabels.shift())
alertcondition(cbLong,  "Confirmed bullish BOS", "Sweep or order block, retrace into FVG/OB, then bullish BOS")
alertcondition(cbShort, "Confirmed bearish BOS", "Sweep or order block, retrace into FVG/OB, then bearish BOS")

// ═════════════════════════ COMBINED SETUP ═════════════════════════
gX = "Combined setup"
showSig = input.bool(false, "Show setup signals", group = gX)
needLiq  = input.bool(false, "Require a liquidity sweep before the shift", group = gX,
     tooltip = "TJR's full setup. Long: a swing-low liquidity level was taken within the window before the bullish order block formed. Short: a swing-high level.")
liqWin   = input.int(30, "Sweep window, candles before the shift", minval = 1, maxval = 500, group = gX)
minShare = input.float(0, "Gap volume must agree, min %", minval = 0, maxval = 100, step = 5, group = gX,
     tooltip = "0 = off. Example 60: a bullish gap only counts if at least 60% of its middle candle's volume was buying (bearish: selling).")

hitFvg(int dir, float obTop, float obBot) =>
    hit = false
    for z in zones
        fresh = box.get_left(z.bx) < time[2]   // not a gap made by this very candle
        overlap = z.bot <= obTop and z.top >= obBot
        volOk = minShare == 0 or na(z.buyPct) or (dir == 1 ? z.buyPct >= minShare : 100 - z.buyPct >= minShare)
        if fresh and overlap and volOk and z.dir == dir and not z.inverted and z.state != "FILLED"
            entered = dir == 1 ? (low <= z.top and close > z.bot) : (high >= z.bot and close < z.top)
            if entered
                hit := true
    hit

longSig  = false
shortSig = false
float sigStop = na
if barstate.isconfirmed
    for o in obs
        sweepIdx = o.dir == 1 ? lastLowSweepIdx : lastHighSweepIdx
        liqOk = not needLiq or (not na(sweepIdx) and sweepIdx <= o.madeIdx and o.madeIdx - sweepIdx <= liqWin)
        if liqOk and not o.fired and ((o.dir == 1 and trend == 1) or (o.dir == -1 and trend == -1))
            if hitFvg(o.dir, o.top, o.bot)
                o.fired := true
                if o.dir == 1
                    longSig := true
                    sigStop := o.bot
                else
                    shortSig := true
                    sigStop := o.top

plotshape(showSig and longSig,  "Long setup",  shape.triangleup,   location.belowbar, color.new(#00e676, 0), size = size.small, text = "L")
plotshape(showSig and shortSig, "Short setup", shape.triangledown, location.abovebar, color.new(#ff1744, 0), size = size.small, text = "S")
plot(showSig ? sigStop : na, "Setup stop", color.new(color.gray, 0), style = plot.style_circles, linewidth = 2)
alertcondition(longSig,  "Long setup",  "Combined: price returned to a bullish FVG inside a bullish order block")
alertcondition(shortSig, "Short setup", "Combined: price returned to a bearish FVG inside a bearish order block")
