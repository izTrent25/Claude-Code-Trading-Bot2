//@version=6
strategy("TJR Research v5 — paper research", overlay=true,
     initial_capital=50000, currency=currency.USD, pyramiding=0,
     default_qty_type=strategy.fixed,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.75,
     slippage=2, backtest_fill_limits_assumption=1,
     process_orders_on_close=false, calc_on_every_tick=false, calc_on_order_fills=false,
     margin_long=1, margin_short=1, max_bars_back=500)
// TJR liquidity sweep, version 5, for a FIVE-MINUTE chart. Rules: research/SPEC_tjr.md.
// Matches the Python "v5-limit" variant: sweep of PDL/PDH, Asia, London or pre-market level ->
// 5m shift with displacement -> 5m fair value gap -> limit at 50% of the gap -> stop beyond the
// sweep -> target the nearest opposite pool at >= 2R. The 1-minute trigger of the Python primary
// cannot run on a 5-minute chart, so this script does not have it.
// Differences from the Python engine: TradingView fills and limit verification, session
// alignment of daily bars, and the tester's own drawdown maths. Not tick-for-tick parity.
if barstate.isfirst and (not timeframe.isminutes or timeframe.multiplier != 5)
    runtime.error("Use a standard 5-minute chart for this research strategy.")

string tz          = input.string("America/Chicago", "Session timezone")
bool   useBias     = input.bool(true, "Only trade with the daily bias")
float  dispMult    = input.float(0.8, "Shift body / average 5m range", minval=0, step=0.1)
int    shiftBars   = input.int(6, "Max 5m bars from sweep to shift", minval=1)
int    gapTicks    = input.int(2, "Minimum gap size (ticks)", minval=1)
float  minRR       = input.float(2.0, "Minimum reward : risk to the target pool", minval=0.5, step=0.5)
int    expireBars  = input.int(12, "Limit order lifetime (5m bars)", minval=1)
int    sweepStart  = input.int(830, "Sweep window start HHMM", minval=0, maxval=2359)
int    sweepEnd    = input.int(930, "Sweep window end HHMM", minval=0, maxval=2359)
int    flattenAt   = input.int(1000, "Flatten HHMM", minval=0, maxval=2359)
int    maxTrades   = input.int(3, "Max entries per day", minval=1)
int    maxLosses   = input.int(2, "Consecutive losses that end the day", minval=1)
float  riskBudget  = input.float(500, "Risk budget per trade (USD)", minval=1)
int    maxQty      = input.int(2, "Maximum contracts", minval=1)
float  costSide    = input.float(0.75, "Sizing: commission / side / contract (USD)", minval=0)
int    slipTicks   = input.int(2, "Sizing: slippage ticks on stop fills", minval=0)
int    startDate   = input.time(timestamp("01 Jan 2010 00:00 +0000"), "Test begins")
int    endDate     = input.time(timestamp("31 Dec 2030 23:59 +0000"), "Test ends")

float tick      = syminfo.mintick
float tickValue = syminfo.mintick * syminfo.pointvalue
int   clock     = hour(time, tz) * 100 + minute(time, tz)
bool  inDates   = time >= startDate and time_close <= endDate

// ---------------------------------------------------------------- daily bias (last daily break of structure)
f_bias() =>
    var float sh = na
    var float sl = na
    var int   bias = 0
    if not na(sh) and close > sh
        bias := 1
    if not na(sl) and close < sl
        bias := -1
    if high[1] > high[2] and high[1] > high
        sh := high[1]
    if low[1] < low[2] and low[1] < low
        sl := low[1]
    bias[1]   // previous completed daily bar's bias: no peeking at the developing day
int dailyBias = request.security(syminfo.tickerid, "D", f_bias(), lookahead=barmerge.lookahead_on)

// ---------------------------------------------------------------- sessions and levels (trading day = 17:00 CT to 16:00 CT)
int shifted  = time + 7 * 3600000   // 17:00 CT becomes 00:00 of the next calendar day
int tradeDay = year(shifted, tz) * 10000 + month(shifted, tz) * 100 + dayofmonth(shifted, tz)
bool newSession = ta.change(tradeDay) != 0
var float curH = na
var float curL = na
var float pdh = na
var float pdl = na
var float asiaH = na
var float asiaL = na
var float londonH = na
var float londonL = na
var float preH = na
var float preL = na
if newSession
    pdh := curH
    pdl := curL
    curH := high
    curL := low
    asiaH := na
    asiaL := na
    londonH := na
    londonL := na
    preH := na
    preL := na
else
    curH := math.max(nz(curH, high), high)
    curL := math.min(nz(curL, low), low)
f_acc(bool inWin, float h, float l) =>
    float nh = inWin ? (na(h) ? high : math.max(h, high)) : h
    float nl = inWin ? (na(l) ? low : math.min(l, low)) : l
    [nh, nl]
[a1, a2] = f_acc(clock >= 1900 and clock < 2300, asiaH, asiaL)
asiaH := a1
asiaL := a2
[l1, l2] = f_acc(clock >= 100 and clock < 400, londonH, londonL)
londonH := l1
londonL := l2
[p1, p2] = f_acc(clock >= 600 and clock < 830, preH, preL)
preH := p1
preL := p2

// ---------------------------------------------------------------- 5m structure
var float swingHigh = na
var float swingLow = na
if clock == 600
    swingHigh := na
    swingLow := na
if clock >= 600
    if high[1] > high[2] and high[1] > high
        swingHigh := high[1]
    if low[1] < low[2] and low[1] < low
        swingLow := low[1]
float avgRange = ta.sma(high - low, 12)[1]

// ---------------------------------------------------------------- day bookkeeping
int dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
var int   entries = 0
var int   lossStreak = 0
var bool  dayDone = false
var int   usedMask = 0
if ta.change(dayKey) != 0
    entries := 0
    lossStreak := 0
    dayDone := false
    usedMask := 0
if ta.change(strategy.closedtrades) > 0
    float lastP = strategy.closedtrades.profit(strategy.closedtrades - 1)
    lossStreak := lastP < 0 ? lossStreak + 1 : 0
    if lossStreak >= maxLosses
        dayDone := true

// ---------------------------------------------------------------- setup state machine
var int   state = 0          // 0 idle, 1 swept, 2 waiting one more bar for a gap, 3 zone/limit working
var int   side = 0
var float level = na
var float extreme = na
var float structure = na
var int   sweepBar = na
var float zoneBot = na
var float zoneTop = na
var int   orderBar = na
var float tradeStop = na
var float tradeTarget = na
var string swept = ""

f_pools(int s) =>
    // [PD, Asia, London, pre-market] levels to sweep for side s; pools to target are the mirror
    float v1 = s == 1 ? pdl : pdh
    float v2 = s == 1 ? asiaL : asiaH
    float v3 = s == 1 ? londonL : londonH
    float v4 = s == 1 ? preL : preH
    [v1, v2, v3, v4]

f_nearestPool(int s, float entry, float risk) =>
    [t1, t2, t3, t4] = f_pools(-s)
    float best = na
    for v in array.from(t1, t2, t3, t4)
        float d = (v - entry) * s
        if not na(v) and d >= minRR * risk and (na(best) or d < (best - entry) * s)
            best := v
    best

f_findGap(int s, int fromBar) =>
    float b = na
    float t = na
    int maxBack = bar_index - fromBar - 2
    if maxBack >= 0
        for i = 0 to math.min(maxBack, 200)
            if s == 1 and low[i] - high[i + 2] >= gapTicks * tick
                b := high[i + 2]
                t := low[i]
                break
            if s == -1 and low[i + 2] - high[i] >= gapTicks * tick
                b := high[i]
                t := low[i + 2]
                break
    [b, t]

bool sweepWindow = clock >= sweepStart and clock < sweepEnd
bool canTrade = inDates and not dayDone and entries < maxTrades and strategy.position_size == 0

if barstate.isconfirmed and inDates
    if state == 0 and sweepWindow and canTrade and (not useBias or dailyBias != 0)
        for s in (useBias ? array.from(dailyBias) : array.from(1, -1))
            if state == 0
                [v1, v2, v3, v4] = f_pools(s)
                int k = 0
                for v in array.from(v1, v2, v3, v4)
                    k += 1
                    int bit = int(math.pow(2, s == 1 ? k - 1 : k + 3))   // one bit per level and side
                    bool used = math.floor(usedMask / bit) % 2 == 1
                    if state == 0 and not na(v) and not used
                        bool isSweep = s == 1 ? (open > v and low < v and close > v) : (open < v and high > v and close < v)
                        if isSweep
                            usedMask += bit
                            float st = s == 1 ? swingHigh : swingLow
                            if not na(st)
                                state := 1
                                side := s
                                level := v
                                extreme := s == 1 ? low : high
                                structure := st
                                sweepBar := bar_index
                                swept := k == 1 ? "PD" : k == 2 ? "Asia" : k == 3 ? "London" : "Pre"
    else if state == 1 or state == 2
        extreme := side == 1 ? math.min(extreme, low) : math.max(extreme, high)
        bool breakout = side == 1 ? close < level : close > level
        if breakout or bar_index - sweepBar > shiftBars + 1
            state := 0
        else
            bool gotShift = state == 2
            if state == 1
                bool broke = side == 1 ? close > structure : close < structure
                float body = side * (close - open)
                gotShift := broke and not na(avgRange) and body >= dispMult * avgRange
            if gotShift
                [gb, gt] = f_findGap(side, sweepBar)
                if not na(gb)
                    float buf = math.max(2 * tick, 0.1 * nz(avgRange))
                    float stopPx = side == 1 ? extreme - buf : extreme + buf
                    float limitPx = math.round_to_mintick((gb + gt) / 2)
                    float risk = side * (limitPx - stopPx)
                    float target = risk > 0 ? f_nearestPool(side, limitPx, risk) : na
                    if not na(target) and canTrade
                        float unitRisk = risk / tick * tickValue + 2 * costSide + slipTicks * tickValue
                        int qty = int(math.min(maxQty, math.floor(riskBudget / unitRisk)))
                        if qty > 0
                            zoneBot := gb
                            zoneTop := gt
                            tradeStop := stopPx
                            tradeTarget := target
                            orderBar := bar_index
                            entries += 1
                            state := 3
                            if side == 1
                                strategy.entry("L", strategy.long, qty=qty, limit=limitPx)
                                strategy.exit("LX", from_entry="L", stop=tradeStop, limit=tradeTarget)
                            else
                                strategy.entry("S", strategy.short, qty=qty, limit=limitPx)
                                strategy.exit("SX", from_entry="S", stop=tradeStop, limit=tradeTarget)
                        else
                            state := 0
                    else
                        state := 0
                else if state == 1
                    state := 2
                else
                    state := 0
    else if state == 3
        bool dead = side == 1 ? low < extreme : high > extreme
        bool expired = bar_index - orderBar > expireBars
        if strategy.position_size != 0
            state := 0
        else if dead or expired or clock >= sweepEnd
            strategy.cancel_all()
            state := 0

if clock >= flattenAt or not inDates
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment="Out by 11 AM ET / session guard", immediately=true)
    state := 0

// ---------------------------------------------------------------- plots
plot(pdh, "PDH", color=color.new(color.red, 60), style=plot.style_linebr)
plot(pdl, "PDL", color=color.new(color.green, 60), style=plot.style_linebr)
plot(asiaH, "Asia high", color=color.new(color.orange, 70), style=plot.style_linebr)
plot(asiaL, "Asia low", color=color.new(color.orange, 70), style=plot.style_linebr)
plot(londonH, "London high", color=color.new(color.blue, 70), style=plot.style_linebr)
plot(londonL, "London low", color=color.new(color.blue, 70), style=plot.style_linebr)
plot(preH, "Pre-market high", color=color.new(color.gray, 70), style=plot.style_linebr)
plot(preL, "Pre-market low", color=color.new(color.gray, 70), style=plot.style_linebr)
plot(state == 3 ? zoneBot : na, "Gap bottom", color=color.new(color.teal, 40), style=plot.style_linebr)
plot(state == 3 ? zoneTop : na, "Gap top", color=color.new(color.teal, 40), style=plot.style_linebr)
plot(strategy.position_size != 0 ? tradeStop : na, "Stop", color=color.red, style=plot.style_linebr)
plot(strategy.position_size != 0 ? tradeTarget : na, "Target pool", color=color.green, style=plot.style_linebr)
plotshape(state == 1 and state[1] == 0, title="Sweep", style=shape.diamond, location=location.belowbar, color=color.yellow, size=size.tiny)
plotshape(state == 3 and state[1] != 3, title="Shift + gap", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
bgcolor(dailyBias == 1 ? color.new(color.green, 95) : dailyBias == -1 ? color.new(color.red, 95) : na)
